@startuml 03-component
!include <C4/C4_Component>

title Telegram bot backend — component diagram

Person(user, "Telegram user", "Sends bot commands or text messages")
System_Ext(telegram, "Telegram Bot API", "Delivers webhook updates and sends bot replies")
System_Ext(jokeApi, "JokeAPI", "Safe jokes by category")
System_Ext(frankfurterApi, "Frankfurter API", "Currency reference rates")
System_Ext(openMeteoApi, "Open-Meteo APIs", "City geocoding and current weather")
System_Ext(dogApi, "Dog CEO API", "Random dog image URLs")

Container_Boundary(bot, "Telegram bot backend") {
    Component(server, "Server startup", "Node.js", "Starts Hono and registers the webhook")
    Component(honoApp, "Hono app", "Hono", "Hosts the HTTP server and root health endpoint")
    Component(messageRouter, "Telegram message router", "Presentation", "HTTP command routes and webhook authentication")
    Component(updateHandler, "Telegram update handler", "Application", "Dispatches commands and replies to unknown text")
    Component(botCommands, "Bot commands", "Application", "Maps commands to their use cases")
    Component(currencyUseCase, "Currency conversion", "Application", "Validates input and formats the converted amount")
    Component(weatherUseCase, "Weather lookup", "Application", "Formats current weather for a city")
    Component(jokeUseCase, "Joke lookup", "Application", "Validates category and formats joke")
    Component(dogUseCase, "Dog image lookup", "Application", "Returns an image URL and caption")
    Component(telegramAdapter, "Telegram API client", "Adapter", "Registers webhook and sends messages or photos")
    Component(currencyAdapter, "Frankfurter API client", "Adapter", "Fetches exchange rates")
    Component(weatherAdapter, "Open-Meteo API client", "Adapter", "Looks up city coordinates and weather")
    Component(jokeAdapter, "Joke API client", "Adapter", "Fetches safe-mode jokes")
    Component(dogAdapter, "Dog API client", "Adapter", "Fetches random dog image URLs")
}

Rel(user, telegram, "Sends commands and text")
Rel(telegram, messageRouter, "POST /telegram/webhook")
Rel(server, telegramAdapter, "Registers webhook")
Rel(server, honoApp, "Starts HTTP server")
Rel(honoApp, messageRouter, "Mounts routes")
Rel(telegramAdapter, telegram, "setWebhook, sendMessage, sendPhoto")
Rel(messageRouter, botCommands, "Handles HTTP command routes")
Rel(messageRouter, updateHandler, "Forwards authenticated webhook update")
Rel(updateHandler, botCommands, "Dispatches recognized command")
Rel(updateHandler, telegramAdapter, "Replies to user")
Rel(botCommands, currencyUseCase, "/convert")
Rel(botCommands, weatherUseCase, "/weather")
Rel(botCommands, jokeUseCase, "/joke")
Rel(botCommands, dogUseCase, "/dog")
Rel(currencyUseCase, currencyAdapter, "Requests rate")
Rel(weatherUseCase, weatherAdapter, "Requests current weather")
Rel(jokeUseCase, jokeAdapter, "Requests joke")
Rel(dogUseCase, dogAdapter, "Requests image")
Rel(currencyAdapter, frankfurterApi, "HTTPS")
Rel(weatherAdapter, openMeteoApi, "HTTPS")
Rel(jokeAdapter, jokeApi, "HTTPS")
Rel(dogAdapter, dogApi, "HTTPS")

SHOW_LEGEND()
@enduml
